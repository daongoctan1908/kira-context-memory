# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.11.2 AS uv

FROM python:3.11-slim-bookworm AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY --from=uv /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md ./
COPY packages/viettel-mem0/pyproject.toml packages/viettel-mem0/README.md packages/viettel-mem0/LICENSE ./packages/viettel-mem0/
COPY packages/viettel-mem0/mem0 ./packages/viettel-mem0/mem0
COPY app ./app
COPY worker ./worker
COPY evaluation ./evaluation
COPY dataset ./dataset
COPY scripts/run_week5_benchmark.py scripts/validate_dataset.py scripts/materialize_dataset.py scripts/week5_mock_acceptance.py ./scripts/

RUN uv sync --frozen --no-dev --extra evaluation --no-editable

FROM python:3.11-slim-bookworm AS runtime

ARG APP_VERSION=0.4.1
ARG SOURCE_REVISION
ARG BENCHMARK_VARIANT=working_tree

LABEL org.opencontainers.image.title="kira-context-memory-eval" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.kira.benchmark.contract="kira-week5-benchmark-v4" \
      io.kira.benchmark.variant="${BENCHMARK_VARIANT}" \
      io.kira.benchmark.role="eval-controller"

ENV APP_VERSION=${APP_VERSION} \
    BENCHMARK_SOURCE_REVISION=${SOURCE_REVISION} \
    BENCHMARK_VARIANT=${BENCHMARK_VARIANT} \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN test -n "${SOURCE_REVISION}" \
    && groupadd --system --gid 10001 kira \
    && useradd --system --uid 10001 --gid kira --home-dir /app --shell /usr/sbin/nologin kira

COPY --from=builder --chown=kira:kira /app/.venv /app/.venv
COPY --chown=kira:kira pyproject.toml ./
COPY --chown=kira:kira packages/viettel-mem0/pyproject.toml ./packages/viettel-mem0/
COPY --chown=kira:kira app ./app
COPY --chown=kira:kira worker ./worker
COPY --chown=kira:kira evaluation ./evaluation
COPY --chown=kira:kira dataset ./dataset
COPY --chown=kira:kira scripts/run_week5_benchmark.py scripts/validate_dataset.py scripts/materialize_dataset.py scripts/week5_mock_acceptance.py ./scripts/

USER kira

ENTRYPOINT ["python", "-m", "scripts.run_week5_benchmark"]
CMD ["validate"]
