# KiRa Test/Lab endpoint. Override per environment.
KIRA_BASE_URL=http://10.255.62.64:8122
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI

# Store only the credential value after the literal "Basic " prefix.
KIRA_BASIC_AUTH=replace_me

KIRA_SERVICE_ID=5
KIRA_DEVICE=Browser
KIRA_MESSAGE_TYPE=text
KIRA_CONNECT_TIMEOUT_SECONDS=5
KIRA_READ_TIMEOUT_SECONDS=300
# Week 1 assumption: tokenExpirationTime is a TTL in seconds.
KIRA_TOKEN_EXPIRY_SKEW_SECONDS=60

# Trusted identity boundary. Static identity is only for controlled local/test use
# and Settings rejects it when APP_ENVIRONMENT=production.
APP_ENVIRONMENT=development
DEV_STATIC_IDENTITY_ENABLED=true
DEV_STATIC_USER_ID=local-dev-user

# Week 2 durable conversation source of truth. Run Alembic before the Gateway.
POSTGRES_DB=kira_context
POSTGRES_USER=kira
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+asyncpg://kira:replace_me@127.0.0.1:5432/kira_context
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT_SECONDS=2
POSTGRES_CONNECT_TIMEOUT_SECONDS=2
POSTGRES_COMMAND_TIMEOUT_SECONDS=5
# End-to-end deadline for each conversation read/write/validation operation.
CONVERSATION_OPERATION_TIMEOUT_SECONDS=5

# Bounded context window read from PostgreSQL; persistent history is not trimmed.
MAX_RECENT_MESSAGES=10

# Recent context budget excludes the current query and system prompt.
RECENT_CONTEXT_TOKEN_BUDGET=3000

# Both values are required for Gateway startup; temporary endpoint outages degrade at runtime.
VLLM_BASE_URL=http://127.0.0.1:8001
VLLM_MODEL=replace_with_actual_served_model_name
# VLLM_API_KEY=replace_me_if_auth_is_enabled
VLLM_CONNECT_TIMEOUT_SECONDS=2
VLLM_READ_TIMEOUT_SECONDS=8
VLLM_MAX_OUTPUT_CHARS=2048

# Week 3 long-term-memory foundation. LTM is wired into /chat in a later batch.
# Runtime adapters never create DB objects; run `python -m worker.memory_admin init`.
LTM_ENABLED=false
MEMORY_DATABASE_URL=postgresql+asyncpg://kira:replace_me@127.0.0.1:5432/kira_context
MEMORY_ADMIN_DATABASE_URL=postgresql+asyncpg://kira:replace_me@127.0.0.1:5432/kira_context
MEMORY_SCHEMA=memory
MEMORY_COLLECTION_NAME=memories
MEMORY_POSTGRES_MIN_CONNECTIONS=1
MEMORY_POSTGRES_MAX_CONNECTIONS=5
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8002
MEMORY_EMBEDDING_MODEL=replace_with_actual_embedding_model
MEMORY_EMBEDDING_DIMS=1024
# MEMORY_EMBEDDING_API_KEY=replace_me_if_auth_is_enabled
MEMORY_EMBEDDING_CONNECT_TIMEOUT_SECONDS=2
MEMORY_EMBEDDING_READ_TIMEOUT_SECONDS=8
MEMORY_LLM_BASE_URL=http://127.0.0.1:8003
MEMORY_LLM_MODEL=replace_with_actual_memory_model
# MEMORY_LLM_API_KEY=replace_me_if_auth_is_enabled
MEMORY_LLM_TEMPERATURE=0
MEMORY_LLM_MAX_TOKENS=1000
MEMORY_OPERATION_TIMEOUT_SECONDS=30
MEMORY_SEARCH_TIMEOUT_SECONDS=3
MEMORY_SEARCH_TOP_K=10
MEMORY_SEARCH_THRESHOLD=0.1

APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
