# KiRa Test/Lab endpoint. Override per environment.
KIRA_BASE_URL=http://10.255.62.64:8122
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI

# Store only the credential value after the literal "Basic " prefix.
KIRA_BASIC_AUTH=replace_me

KIRA_SERVICE_ID=5
KIRA_DEVICE=Browser
KIRA_MESSAGE_TYPE=text
KIRA_CONNECT_TIMEOUT_SECONDS=5
KIRA_READ_TIMEOUT_SECONDS=300
# Week 1 assumption: tokenExpirationTime is a TTL in seconds.
KIRA_TOKEN_EXPIRY_SKEW_SECONDS=60

APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
