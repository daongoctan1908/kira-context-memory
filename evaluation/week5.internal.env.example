# Copy to .env.week5.internal.local. Never commit the populated file.
# Image values make bare Compose validation possible. StartControl/StartCandidate override them with
# the exact runtime/eval pair declared in image-manifest.json.
WEEK5_CONTROL_IMAGE=kira-context-control:replace_with_control_sha
WEEK5_CANDIDATE_IMAGE=kira-context-candidate:replace_with_candidate_sha
WEEK5_EVAL_IMAGE=kira-context-eval:replace_with_harness_sha
WEEK5_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
WEEK5_POSTGRES_PASSWORD=replace_me
# Non-secret eval target selectors. Change all four together when probing the control stack.
WEEK5_BENCHMARK_GATEWAY_HOST=candidate-gateway
WEEK5_BENCHMARK_WORKER_HOST=candidate-worker
WEEK5_BENCHMARK_POSTGRES_HOST=candidate-postgres
WEEK5_BENCHMARK_DATABASE=kira_candidate
WEEK5_ARTIFACT_ROOT=./artifacts/week5
WEEK5_DATASET_ROOT=./dataset/kira_ltm_v1
WEEK5_MATERIALIZATION_ROOT=./artifacts/week5
WEEK5_MATERIALIZATION_CHECKPOINT=./artifacts/week5/kira-materialization.json

# Internal providers. Keep model/deployment names exact and unchanged across paired runs.
WEEK5_EXTRACTION_BASE_URL=http://replace-with-internal-memory-llm/v1
WEEK5_EXTRACTION_MODEL=replace_with_internal_extraction_model
WEEK5_EXTRACTION_API_KEY=replace_me_if_required
WEEK5_REWRITE_BASE_URL=http://replace-with-internal-rewriter/v1
WEEK5_REWRITE_MODEL=replace_with_internal_rewrite_model
WEEK5_REWRITE_API_KEY=replace_me_if_required
WEEK5_EMBEDDING_BASE_URL=http://replace-with-internal-embedding/v1
WEEK5_EMBEDDING_MODEL=replace_with_internal_embedding_model
WEEK5_EMBEDDING_API_KEY=replace_me_if_required
WEEK5_EMBEDDING_DIMENSIONS=1024
WEEK5_JUDGE_BASE_URL=http://replace-with-internal-judge/v1
WEEK5_JUDGE_MODEL=replace_with_internal_judge_model
WEEK5_JUDGE_DEPLOYMENT=replace_with_exact_deployment
WEEK5_JUDGE_API_KEY=replace_me_if_required
WEEK5_RETRIEVAL_TOP_K=10
WEEK5_RETRIEVAL_THRESHOLD=0.1

# KiRa and native runtime settings used by both control and candidate.
KIRA_BASE_URL=http://replace-with-kira
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI
KIRA_BASIC_AUTH=replace_me
VLLM_BASE_URL=http://replace-with-internal-rewriter/v1
VLLM_MODEL=replace_with_internal_rewrite_model
VLLM_API_KEY=replace_me_if_required
MEMORY_EMBEDDING_BASE_URL=http://replace-with-internal-embedding/v1
MEMORY_EMBEDDING_MODEL=replace_with_internal_embedding_model
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDING_API_KEY=replace_me_if_required
MEMORY_LLM_BASE_URL=http://replace-with-internal-memory-llm/v1
MEMORY_LLM_MODEL=replace_with_internal_extraction_model
MEMORY_LLM_API_KEY=replace_me_if_required

# Evaluation controller endpoints are derived from the selectors above by Compose.
WEEK5_KIRA_MOCK_URL=http://replace-with-kira
WEEK5_MEMORY_SCHEMA=memory
WEEK5_MEMORY_COLLECTION=memories
