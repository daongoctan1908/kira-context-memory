# Company-PC Phase 4 template. Copy to .env.week5.pc.local and never commit the populated file.
# All four OpenAI-compatible provider declarations are explicit; pc_openai_acceptance never falls
# back to shared OPENAI_* variables.
WEEK5_CONTROL_IMAGE=kira-context-control:replace_with_control_sha
WEEK5_CANDIDATE_IMAGE=kira-context-candidate:replace_with_candidate_sha
WEEK5_EVAL_IMAGE=kira-context-eval:replace_with_harness_sha
WEEK5_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
WEEK5_POSTGRES_PASSWORD=replace_me
WEEK5_BENCHMARK_GATEWAY_HOST=candidate-gateway
WEEK5_BENCHMARK_WORKER_HOST=candidate-worker
WEEK5_BENCHMARK_POSTGRES_HOST=candidate-postgres
WEEK5_BENCHMARK_DATABASE=kira_candidate
WEEK5_ARTIFACT_ROOT=./artifacts/week5
WEEK5_DATASET_ROOT=./dataset/kira_ltm_v1
WEEK5_MATERIALIZATION_ROOT=./artifacts/week5
WEEK5_MATERIALIZATION_CHECKPOINT=./artifacts/week5/kira-materialization.json

# Explicit OpenAI endpoints/models/keys used by the evaluator.
WEEK5_EXTRACTION_BASE_URL=https://api.openai.com/v1
WEEK5_EXTRACTION_MODEL=replace_with_approved_chat_model
WEEK5_EXTRACTION_API_KEY=replace_me
WEEK5_REWRITE_BASE_URL=https://api.openai.com/v1
WEEK5_REWRITE_MODEL=replace_with_approved_chat_model
WEEK5_REWRITE_API_KEY=replace_me
WEEK5_EMBEDDING_BASE_URL=https://api.openai.com/v1
WEEK5_EMBEDDING_MODEL=replace_with_approved_embedding_model
WEEK5_EMBEDDING_API_KEY=replace_me
WEEK5_EMBEDDING_DIMENSIONS=1536
WEEK5_JUDGE_BASE_URL=https://api.openai.com/v1
WEEK5_JUDGE_MODEL=replace_with_approved_judge_model
WEEK5_JUDGE_DEPLOYMENT=replace_with_exact_deployment_or_model
WEEK5_JUDGE_API_KEY=replace_me
WEEK5_JUDGE_MAX_TOKENS=512
WEEK5_RETRIEVAL_TOP_K=10
WEEK5_RETRIEVAL_THRESHOLD=0.1
WEEK5_EXTRACTION_JSON_MODE=json_object
WEEK5_CONNECT_TIMEOUT_SECONDS=5
WEEK5_READ_TIMEOUT_SECONDS=60
WEEK5_TOTAL_TIMEOUT_SECONDS=90

# KiRa Test. KIRA_BASIC_AUTH is only the value after the literal "Basic " prefix.
KIRA_BASE_URL=http://replace-with-approved-kira-host
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI
KIRA_BASIC_AUTH=replace_me
KIRA_SERVICE_ID=5
KIRA_DEVICE=Browser
KIRA_MESSAGE_TYPE=text

# Native Gateway/Worker adapters use the same exact OpenAI models as the evaluator declarations.
VLLM_BASE_URL=https://api.openai.com/v1
VLLM_MODEL=replace_with_approved_chat_model
VLLM_API_KEY=replace_me
MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_MODEL=replace_with_approved_embedding_model
MEMORY_EMBEDDING_DIMS=1536
MEMORY_EMBEDDING_API_KEY=replace_me
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_MODEL=replace_with_approved_chat_model
MEMORY_LLM_API_KEY=replace_me

WEEK5_KIRA_MOCK_URL=http://replace-with-approved-kira-host
WEEK5_MEMORY_SCHEMA=memory
WEEK5_MEMORY_COLLECTION=memories
