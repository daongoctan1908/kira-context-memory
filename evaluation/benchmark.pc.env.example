# Company-PC benchmark template. Copy to an ignored local file and never commit it.
# All four OpenAI-compatible provider declarations are explicit; pc_openai_acceptance never falls
# back to shared OPENAI_* variables.
BENCHMARK_CONTROL_IMAGE=kira-context-control:replace_with_control_sha
BENCHMARK_CANDIDATE_IMAGE=kira-context-candidate:replace_with_candidate_sha
BENCHMARK_EVAL_IMAGE=kira-context-eval:replace_with_harness_sha
BENCHMARK_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
BENCHMARK_POSTGRES_PASSWORD=replace_me
BENCHMARK_GATEWAY_HOST=candidate-gateway
BENCHMARK_WORKER_HOST=candidate-worker
BENCHMARK_POSTGRES_HOST=candidate-postgres
BENCHMARK_DATABASE=kira_candidate
BENCHMARK_ARTIFACT_ROOT=./artifacts/benchmark
BENCHMARK_DATASET_ROOT=./dataset/kira_ltm_v1
BENCHMARK_MATERIALIZATION_ROOT=./artifacts/benchmark

# Explicit OpenAI endpoints/models/keys used by the evaluator.
BENCHMARK_EXTRACTION_BASE_URL=https://api.openai.com/v1
BENCHMARK_EXTRACTION_MODEL=replace_with_approved_chat_model
BENCHMARK_EXTRACTION_API_KEY=replace_me
BENCHMARK_REWRITE_BASE_URL=https://api.openai.com/v1
BENCHMARK_REWRITE_MODEL=replace_with_approved_chat_model
BENCHMARK_REWRITE_API_KEY=replace_me
BENCHMARK_EMBEDDING_BASE_URL=https://api.openai.com/v1
BENCHMARK_EMBEDDING_MODEL=replace_with_approved_embedding_model
BENCHMARK_EMBEDDING_API_KEY=replace_me
BENCHMARK_EMBEDDING_DIMENSIONS=1536
BENCHMARK_JUDGE_BASE_URL=https://api.openai.com/v1
BENCHMARK_JUDGE_MODEL=replace_with_approved_judge_model
BENCHMARK_JUDGE_DEPLOYMENT=replace_with_exact_deployment_or_model
BENCHMARK_JUDGE_API_KEY=replace_me
BENCHMARK_JUDGE_MAX_TOKENS=512
BENCHMARK_RETRIEVAL_TOP_K=10
BENCHMARK_RETRIEVAL_THRESHOLD=0.1
BENCHMARK_EXTRACTION_JSON_MODE=json_object
BENCHMARK_CONNECT_TIMEOUT_SECONDS=5
BENCHMARK_READ_TIMEOUT_SECONDS=60
BENCHMARK_TOTAL_TIMEOUT_SECONDS=90

# KiRa Test. KIRA_BASIC_AUTH is only the value after the literal "Basic " prefix.
KIRA_BASE_URL=http://replace-with-approved-kira-host
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI
KIRA_BASIC_AUTH=replace_me
KIRA_SERVICE_ID=5
KIRA_DEVICE=Browser
KIRA_MESSAGE_TYPE=text

# Native Gateway/Worker adapters use the same exact OpenAI models as the evaluator declarations.
VLLM_BASE_URL=https://api.openai.com/v1
VLLM_MODEL=replace_with_approved_chat_model
VLLM_API_KEY=replace_me
MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_MODEL=replace_with_approved_embedding_model
MEMORY_EMBEDDING_DIMS=1536
MEMORY_EMBEDDING_API_KEY=replace_me
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_MODEL=replace_with_approved_chat_model
MEMORY_LLM_API_KEY=replace_me

BENCHMARK_KIRA_MOCK_URL=http://replace-with-approved-kira-host
BENCHMARK_MEMORY_SCHEMA=memory
BENCHMARK_MEMORY_COLLECTION=memories
