# Copy to .env.week5.local in the repository root, then fill local values.
# Run with --env-file .env.week5.local --env-file-only to ignore inherited keys.
OPENAI_API_KEY=
WEEK5_OPENAI_BASE_URL=https://api.openai.com/v1
WEEK5_OPENAI_CHAT_MODEL=
WEEK5_OPENAI_EMBEDDING_MODEL=

# Optional: omit dimension for discovery; set to request AND verify that dimension.
WEEK5_EMBEDDING_DIMENSIONS=
WEEK5_EXTRACTION_JSON_MODE=json_object
WEEK5_CONNECT_TIMEOUT_SECONDS=2
WEEK5_READ_TIMEOUT_SECONDS=8
WEEK5_TOTAL_TIMEOUT_SECONDS=15

# PostgreSQL URIs are excluded from repr, serialized config and config hash.
# Preflight reads only. Future write suites require a dedicated disposable database.
WEEK5_DATABASE_URL=
WEEK5_MEMORY_DATABASE_URL=
WEEK5_MEMORY_SCHEMA=memory
WEEK5_MEMORY_COLLECTION=memories

# Needed only by cross_session preflight. KiRa here is the existing synthetic mock.
WEEK5_GATEWAY_URL=
WEEK5_WORKER_URL=
WEEK5_KIRA_MOCK_URL=

# For internal_test, configure each endpoint explicitly. Shared OPENAI_* is ignored.
# A custom endpoint override never inherits the shared OPENAI_API_KEY.
WEEK5_EXTRACTION_BASE_URL=
WEEK5_EXTRACTION_MODEL=
WEEK5_EXTRACTION_API_KEY=
WEEK5_REWRITE_BASE_URL=
WEEK5_REWRITE_MODEL=
WEEK5_REWRITE_API_KEY=
WEEK5_EMBEDDING_BASE_URL=
WEEK5_EMBEDDING_MODEL=
WEEK5_EMBEDDING_API_KEY=
