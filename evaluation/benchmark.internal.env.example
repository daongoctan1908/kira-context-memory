# Internal benchmark template. Copy to an ignored local file. Never commit it.
# Image values make bare Compose validation possible. StartControl/StartCandidate override them with
# the exact runtime/eval pair declared in image-manifest.json.
BENCHMARK_CONTROL_IMAGE=kira-context-control:replace_with_control_sha
BENCHMARK_CANDIDATE_IMAGE=kira-context-candidate:replace_with_candidate_sha
BENCHMARK_EVAL_IMAGE=kira-context-eval:replace_with_harness_sha
BENCHMARK_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16-bookworm
BENCHMARK_POSTGRES_PASSWORD=replace_me
# Non-secret eval target selectors. Change all four together when probing the control stack.
BENCHMARK_GATEWAY_HOST=candidate-gateway
BENCHMARK_WORKER_HOST=candidate-worker
BENCHMARK_POSTGRES_HOST=candidate-postgres
BENCHMARK_DATABASE=kira_candidate
BENCHMARK_ARTIFACT_ROOT=./artifacts/benchmark
BENCHMARK_DATASET_ROOT=./dataset/kira_ltm_v1
BENCHMARK_MATERIALIZATION_ROOT=./artifacts/benchmark

# Internal providers. Keep model/deployment names exact and unchanged across paired runs.
BENCHMARK_EXTRACTION_BASE_URL=http://replace-with-internal-memory-llm/v1
BENCHMARK_EXTRACTION_MODEL=replace_with_internal_extraction_model
BENCHMARK_EXTRACTION_API_KEY=replace_me_if_required
# User-provided production rewrite binding: Qwen3-14B base served by vLLM, without LoRA.
BENCHMARK_REWRITE_BASE_URL=http://10.254.135.40:8080/v1
BENCHMARK_REWRITE_MODEL=/models/Qwen3_14B
BENCHMARK_REWRITE_API_KEY=replace_me_if_required
BENCHMARK_EMBEDDING_BASE_URL=http://replace-with-internal-embedding/v1
BENCHMARK_EMBEDDING_MODEL=replace_with_internal_embedding_model
BENCHMARK_EMBEDDING_API_KEY=replace_me_if_required
BENCHMARK_EMBEDDING_DIMENSIONS=1024
BENCHMARK_JUDGE_BASE_URL=http://replace-with-internal-judge/v1
BENCHMARK_JUDGE_MODEL=replace_with_internal_judge_model
BENCHMARK_JUDGE_DEPLOYMENT=replace_with_exact_deployment
BENCHMARK_JUDGE_API_KEY=replace_me_if_required
BENCHMARK_RETRIEVAL_TOP_K=10
BENCHMARK_RETRIEVAL_THRESHOLD=0.1

# KiRa and native runtime settings used by both control and candidate.
KIRA_BASE_URL=http://replace-with-kira
KIRA_USERNAME=replace_me
KIRA_DOMAIN=VBI
KIRA_BASIC_AUTH=replace_me
VLLM_BASE_URL=http://10.254.135.40:8080/v1
VLLM_MODEL=/models/Qwen3_14B
VLLM_API_KEY=replace_me_if_required
MEMORY_EMBEDDING_BASE_URL=http://replace-with-internal-embedding/v1
MEMORY_EMBEDDING_MODEL=replace_with_internal_embedding_model
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDING_API_KEY=replace_me_if_required
MEMORY_LLM_BASE_URL=http://replace-with-internal-memory-llm/v1
MEMORY_LLM_MODEL=replace_with_internal_extraction_model
MEMORY_LLM_API_KEY=replace_me_if_required

# Evaluation controller endpoints are derived from the selectors above by Compose.
BENCHMARK_KIRA_MOCK_URL=http://replace-with-kira
BENCHMARK_MEMORY_SCHEMA=memory
BENCHMARK_MEMORY_COLLECTION=memories
